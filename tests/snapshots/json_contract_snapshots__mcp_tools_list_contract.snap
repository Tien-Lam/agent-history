{
  "tools": [
    {
      "description": "Full-text search across indexed sessions. Returns hits with stable citation refs (`<provider>/<session-id>#<turn>` locally, `<source>:<provider>/<session-id>#<turn>` for remote sources). Refreshes the index incrementally before searching.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Tantivy query string. Matches the `content` and `project` fields.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search_sessions",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "hits": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "explanation": {
                  "description": "Present only with --debug-search; Tantivy score explanation tree.",
                  "type": "object"
                },
                "kind": {
                  "description": "Whether the hit points at a session message or a metadata note.",
                  "enum": [
                    "message",
                    "note"
                  ],
                  "type": "string"
                },
                "message_id": {
                  "type": "string"
                },
                "note_id": {
                  "description": "Present for note hits; absent for message hits.",
                  "type": "integer"
                },
                "project": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "provider": {
                  "enum": [
                    "claude-code",
                    "copilot-cli",
                    "gemini-cli",
                    "codex-cli",
                    "opencode",
                    "cursor",
                    "aider",
                    "zed-ai",
                    "cline",
                    "continue-dev",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "description": "Citation ref for message hits, or the note's stored session ref for note hits.",
                  "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]*:)?(claude-code|copilot-cli|gemini-cli|codex-cli|opencode|cursor|aider|zed-ai|cline|continue-dev)/[^#]+(#[1-9][0-9]*)?$",
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "session_id": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "source": {
                  "description": "`local` for this host, or a registered remote source name.",
                  "type": "string"
                },
                "started_at": {
                  "format": "date-time",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "turn": {
                  "description": "Present when the hit has been resolved to a 1-based turn number.",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "session_id",
                "message_id",
                "score",
                "snippet",
                "provider",
                "project",
                "started_at",
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "limit": {
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "source_errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "error": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source",
                "error"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "query",
          "limit",
          "total",
          "hits",
          "source_errors"
        ],
        "type": "object"
      }
    },
    {
      "description": "List sessions across MCP-visible local providers and registered remote source caches, sorted by start time descending.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
